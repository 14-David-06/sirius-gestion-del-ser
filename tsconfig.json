{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    /**
     * `@sirius/solicitudes` NO va aquí: se resuelve por el workspace de npm
     * (node_modules/@sirius/solicitudes → packages/solicitudes) y por el campo
     * `exports` de su package.json. Un alias lo cortocircuitaría, y entonces
     * este repo compilaría con rutas que la app que instale el paquete no tiene
     * — las subrutas (`/server`, `/compensacion`) dejarían de verificarse.
     */
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
